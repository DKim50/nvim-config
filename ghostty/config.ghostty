# Ghostty config, set up to look like Terminal.app's "Basic" profile.
#
# It lives in the nvim-config repo (~/.config/nvim/ghostty/) so it's saved
# on GitHub with the Neovim config. Ghostty reads this folder through a link:
#   ~/.config/ghostty -> ~/.config/nvim/ghostty
# so custom themes in themes/ (like Kali Dark) work by name too.
#
# Cmd ,        opens this file
# Cmd Shift ,  reloads it after you save (some settings need a new window)
#
# Format: one "setting = value" per line. Comments go on their own line:
# anything after a value, even a #, becomes part of the value.
# All options: https://ghostty.org/docs/config

# ---------- Font ----------
# The patched font Neovim's Orion file icons need. Terminal uses 11.
# On non-Retina monitors Ghostty can only draw whole pixel sizes, so
# 11.5 shows as 12px there (exactly 11.5 on a Retina screen).
font-family = JetBrainsMono Orion
font-size = 11.5
# Terminal rounds this font's line height up one pixel more than Ghostty
# (16px vs 15 at size 11), so add that pixel to space lines like Terminal
adjust-cell-height = 1
# Draw letters a little heavier, as Terminal does on non-Retina monitors.
# Without it thin white text looks gray. Lower font-thicken-strength
# (0-255, default 255) if it looks too bold.
font-thicken = true
# SemiBold weight for normal text, so code doesn't look thin. Lighter:
# Medium (and Medium Italic); delete both lines to go back to Regular.
# Bold text stays Bold.
font-style = SemiBold
font-style-italic = SemiBold Italic

# ---------- Background ----------
# 80% solid so the desktop shows through, lightly blurred.
# Terminal's blur slider (10%) is a blur radius of 6.
background-opacity = 0.8
background-blur = 6

# ---------- Cursor and bold ----------
# Block cursor that doesn't blink, like Terminal
cursor-style = block
cursor-style-blink = false
# Bold text in a color uses the bright version of it, like Terminal
bold-color = bright

# ---------- Colors ----------
# Trying Kali Linux's terminal colors (themes/Kali Dark): dark slate
# background, Kali blue and teal. Other themes to switch to:
#   Builtin Tango Dark   Linux's Tango (GNOME Terminal's colors)
# Browse more with: ghostty +list-themes
theme = Kali Dark
# Kali's own background is a lighter slate (#23252e), which makes text look
# thin. Keep the near-black instead; delete this line for Kali's slate.
background = #121212

# Terminal.app's colors, turned off while trying a theme ("# " in front),
# because these lines win over any theme. To go back to them: delete the
# theme line above and remove the "# " from these lines.
# background = #121212
# foreground = #ffffff
# cursor-color = #9d9d9d
# selection-background = #3f638b
# selection-foreground = cell-foreground
# palette = 0=#000000
# palette = 1=#c23621
# palette = 2=#25bc24
# palette = 3=#adad27
# palette = 4=#492ee1
# palette = 5=#d338d3
# palette = 6=#33bbc8
# palette = 7=#cbcccd
# palette = 8=#818383
# palette = 9=#fc391f
# palette = 10=#31e722
# palette = 11=#eaec23
# palette = 12=#5833ff
# palette = 13=#f935f8
# palette = 14=#14f0f0
# palette = 15=#e9ebeb

# ---------- Window ----------
# Normal macOS title bar and tabs, new windows 80 x 24 like Terminal
macos-titlebar-style = native
window-width = 80
window-height = 24
# Space between the window edge and the text: 10 left and right,
# 6 top and 10 bottom
window-padding-x = 10
window-padding-y = 6,10
# Resize in whole characters, like Terminal, so no uneven gap at the edges
window-step-resize = true

# ---------- Keys ----------
# Option works as Meta/Alt, like Terminal's "Use Option as Meta key"
macos-option-as-alt = true
